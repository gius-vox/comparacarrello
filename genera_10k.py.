print("Generazione del database pulito e diversificato di 10.000 prodotti in corso...")

righe_generate = []
minsan_counter = 100000001 # Partiamo da un MINSAN valido a 9 cifre

# Generiamo combinazioni logiche finché non arriviamo a 10.000
while len(righe_generate) < num_prodotti_target:
    cat = random.choice(list(CATEGORIE_DATI.keys()))
    brand, varianti = random.choice(CATEGORIE_DATI[cat])
    var_nome, p_min, p_max = random.choice(varianti)
    
    # Creiamo un nome pulito, univoco e professionale
    nome_prodotto = f"{brand.upper()} {var_nome.upper()}"
    
    # Evitiamo duplicati esatti nel set
    if any(r['Prodotto'] == nome_prodotto for r in righe_generate):
        # Aggiungiamo una piccola variante numerica o lotto se esiste già
        nome_prodotto = f"{brand.upper()} {var_nome.upper()} - CONF. {random.choice(['speciale', 'risparmio', '2026', 'PROMO'])}"

    minsan_str = str(minsan_counter)
    minsan_counter += 1
    
    # Generiamo i prezzi coerenti per ciascuna delle 9 farmacie attorno al range base
    prezzo_base = round(random.uniform(p_min, p_max), 2)
    
    row_data = {
        "MINSAN": minsan_str,
        "Prodotto": nome_prodotto,
        "Categoria": cat,
        "Immagine_URL": ""
    }
    
    for farmacia in farmacie:
        # Ogni farmacia applica una piccola variazione casuale (-15% / +15%) rispetto al prezzo base
        coeff_farmacia = random.uniform(0.85, 1.18)
        prezzo_farma = round(prezzo_base * coeff_farmacia, 2)
        row_data[farmacia] = f"{prezzo_farma:.2f}"
        
    righe_generate.append(row_data)

# Creazione del DataFrame e salvataggio in CSV
df_finale = pd.DataFrame(righe_generate)
df_finale.to_csv("prodotti_10000_ufficiale.csv", index=False)
